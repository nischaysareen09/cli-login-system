# Path to the SQLite database file inside the container.
# Should point into the mounted volume so data persists across restarts.
DB_PATH=/data/app.db

# How long a login session stays valid, in minutes.
SESSION_TIMEOUT_MINUTES=15

# How many consecutive failed login attempts before an account is locked.
MAX_FAILED_ATTEMPTS=5

# How long an account stays locked after hitting MAX_FAILED_ATTEMPTS, in minutes.
LOCKOUT_DURATION_MINUTES=5

# Bonus web UI (see README) — runs alongside the CLI, sharing the same
# database. Set to false to disable it entirely; the CLI is unaffected
# either way.
WEB_UI_ENABLED=true

# Port the bonus web UI listens on inside the container.
WEB_UI_PORT=8080
